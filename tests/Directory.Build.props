<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <RollForward>major</RollForward>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1034</NoWarn>    <!-- Nested types should not be visible -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>    <!-- Validate arguments of public methods -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>    <!-- Consider making public types internal --><!-- workaround for https://github.com/dotnet/roslyn-analyzers/issues/7734 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>    <!-- Missing XML comment for publicly visible type or member --><!-- workaround for https://github.com/dotnet/roslyn/issues/41640 -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>    <!-- Do not directly await a Task -->
    <NoWarn>$(NoWarn);VSTHRD111</NoWarn>    <!-- Add .ConfigureAwait(bool) to your await expression -->
    <NoWarn>$(NoWarn);VSTHRD200</NoWarn>    <!-- Use "Async" suffix in names of methods that return an awaitable type -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/AssemblyAttributes.cs" Link="AssemblyAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

</Project>
