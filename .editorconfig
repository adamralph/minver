root                                                                      = true

[*]
charset                                                                   = utf-8
end_of_line                                                               = crlf
indent_size                                                               = 2
indent_style                                                              = space
insert_final_newline                                                      = true
trim_trailing_whitespace                                                  = true

[*.cs]
csharp_style_expression_bodied_accessors                                  = true # default; kept for consistency across the group
csharp_style_expression_bodied_constructors                               = true
csharp_style_expression_bodied_indexers                                   = true # default; kept for consistency across the group
csharp_style_expression_bodied_lambdas                                    = true
csharp_style_expression_bodied_local_functions                            = true
csharp_style_expression_bodied_methods                                    = true
csharp_style_expression_bodied_operators                                  = true
csharp_style_expression_bodied_properties                                 = true # default; kept for consistency across the group
csharp_style_namespace_declarations                                       = file_scoped
csharp_style_var_elsewhere                                                = true
csharp_style_var_for_built_in_types                                       = true
csharp_style_var_when_type_is_apparent                                    = true
dotnet_separate_import_directive_groups                                   = false # default; partial workaround for https://github.com/dotnet/sdk/issues/56416
dotnet_sort_system_directives_first                                       = true # default; partial workaround for https://github.com/dotnet/sdk/issues/56416
file_header_template                                                      = unset
indent_size                                                               = 4

[build]
end_of_line                                                               = lf

[packages.lock.json]
end_of_line                                                               = unset
insert_final_newline                                                      = unset
